# =============================================================================
# SANITIZED TEMPLATE — mutual-aid-boulder instance of the rivr-group pm-core module.
#
# This is an EXAMPLE. Every credential/secret VALUE below has been replaced with
# a __PLACEHOLDER_*__ token. NON-secret parity config (DOMAIN, DATABASE_NAME,
# INSTANCE_ID, *_URL, Stripe price IDs, agent UUIDs) is kept verbatim as a
# reference for how a real instance is shaped.
#
# The REAL per-instance env (with live values) is git-ignored and lives ONLY on
# the deploy host at:
#     /opt/docker-lab/modules/rivr-group/instances/mutual-aid-boulder.env
# File-based docker secrets (rivr_db_password, rivr_auth_secret, minio_*,
# matrix_admin_token*, synapse_*_registration_shared_secret, ...) live at:
#     /opt/docker-lab/secrets/            (see ../secrets-required.txt)
#
# To provision a new instance: copy this file to instances/<slug>.env and fill
# each __PLACEHOLDER_*__ from the host secret store / your Stripe + federation
# configuration.
# =============================================================================

MODULE_SLUG=mutual-aid-boulder
DOMAIN=mutual-aid-boulder.rivr.social
MATRIX_TOKEN_SRC=matrix_admin_token_mab
SYNAPSE_REG_SRC=synapse_mab_registration_shared_secret
ASSET_PUBLIC_BASE_URL=https://s3.rivr.social
AUTH_TRUST_HOST=true
BASE_URL=https://mutual-aid-boulder.rivr.social
DATABASE_HOST=postgres
DATABASE_NAME=rivr_group_mab
DATABASE_PORT=5432
DATABASE_USER=rivr
