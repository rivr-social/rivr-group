# RIVR Group module — per-INSTANCE environment. Copy to .env on the target host.
# ONE module, many instances: everything that differs lives HERE.
DOMAIN=spirit-of-the-front-range.rivr.social
INSTANCE_SLUG=group-boulder
INSTANCE_TYPE=group
RIVR_DB_NAME=rivr_group_boulder
NEXTAUTH_URL=https://spirit-of-the-front-range.rivr.social
# RIVR_IMAGE is loaded from image.lock by the deploy script (single-sourced digest).
