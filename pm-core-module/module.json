{
  "$schema": "../../foundation/schemas/module.schema.json",
  "id": "rivr-group",
  "version": "1.0.0",
  "name": "RIVR Group App",
  "description": "RIVR sovereign group/org/community instance. One module serves every group-codebase instance (e.g. Spirit of the Front Range, Regen Hub) — instances differ ONLY by .env. Image is digest-pinned in image.lock; no per-host build.",
  "author": { "name": "RIVR" },
  "license": "MIT",
  "repository": "https://github.com/rivr-social/rivr-group",
  "tags": ["rivr", "group", "sovereign", "org", "community"],
  "foundation": { "minVersion": "1.0.0" },
  "requires": {
    "connections": [
      { "type": "database", "providers": ["postgres"], "required": true, "alias": "rivr-db" },
      { "type": "storage", "providers": ["minio", "s3"], "required": true, "alias": "rivr-objstore" }
    ],
    "modules": []
  },
  "provides": {
    "events": [
      "rivr-group.instance.started",
      "rivr-group.instance.stopped",
      "rivr-group.federation-sync.completed",
      "rivr-group.federation-sync.failed"
    ]
  },
  "lifecycle": {
    "install": { "script": "./hooks/install.sh", "timeout": 120 },
    "start": { "script": "./hooks/start.sh", "timeout": 120 },
    "stop": { "script": "./hooks/stop.sh", "timeout": 60 },
    "uninstall": "./hooks/uninstall.sh",
    "health": { "script": "./hooks/health.sh", "timeout": 30 }
  },
  "config": {
    "version": "1.0",
    "required": ["domain", "instanceSlug", "dbName"],
    "properties": {
      "domain": { "type": "string", "env": "DOMAIN", "description": "Public host (e.g. spirit-of-the-front-range.rivr.social)" },
      "instanceSlug": { "type": "string", "env": "INSTANCE_SLUG", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Per-instance slug (e.g. group-boulder, group-regen-hub)" },
      "instanceType": { "type": "string", "default": "group", "enum": ["group"], "env": "INSTANCE_TYPE", "description": "RIVR instance type" },
      "dbName": { "type": "string", "env": "RIVR_DB_NAME", "description": "Postgres database name (e.g. rivr_group_boulder)" },
      "nextauthUrl": { "type": "string", "env": "NEXTAUTH_URL", "description": "Absolute base URL for NextAuth" },
      "imageRef": { "type": "string", "env": "RIVR_IMAGE", "description": "Digest-pinned image; supplied from image.lock by the deploy script. Do not hand-edit." }
    }
  }
}
